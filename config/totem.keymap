//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define BLU  3

/ {
    behaviors {
        macros {
            roundbkt: round_brackets {
                label = "round_brackets";
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&macro_tap>, <&kp LPAR &kp RPAR>;
            };

            squarebkt: square_brackets {
                label = "square_brackets";
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&macro_tap>, <&kp LBKT &kp RBKT &kp LEFT>;
            };

            curlbkt: curl_brackets {
                label = "curl_brackets";
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&macro_tap>, <&kp LBRC &kp RBRC &kp LEFT>;
            };
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        combos {
            compatible = "zmk,combos";

            combo_layer3 {
                timeout-ms = <50>;
                key-positions = <34 35>;
                layers = <BASE>;
                bindings = <&mo BLU>;
            };
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            label = "BASE";
            // Visual map and hold/tap legend: docs/KEYMAP.md#base-layer

            bindings = <
       &kp Q       &kp W       &kp E        &kp R        &kp T          &kp Y       &kp U        &kp I        &kp O       &kp P
       &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHFT F  &kp G          &kp H       &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm SEMI SQT
&kp F2 &kp Z       &kp X       &kp C        &kp V        &kp B          &lt SYM N   &kp M        &kp COMMA    &kp DOT     &hm BSLH FSLH  &kp F4
                               &kp ESC      &lt SYM TAB  &lt NAV SPACE  &kp BSPC    &kp DEL      &kp ENTER
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        nav_layer {
            label = "NAVI";
            // Hold Space to activate. Visual map: docs/KEYMAP.md#navigation-layer

            bindings = <
       &kp KP_PLUS      &kp N1  &kp N2         &kp N3     &kp LPAR    &kp RPAR   &kp HOME  &kp UP     &kp END    &kp PG_UP
       &kp KP_MINUS     &kp N4  &kp N5         &kp N6     &kp N0      &kp EQUAL  &kp LEFT  &kp DOWN   &kp RIGHT  &kp PG_DN
&kp HOME  &kp KP_MULTIPLY  &kp N7  &kp N8         &kp N9     &kp DOT     &none      &kp CAPS  &kp KP_NUM  &none      &none      &kp END
                                &kp KP_DIVIDE  &hm F2 F4  &trans      &kp BSPC   &kp DEL   &kp ENTER
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        sim_layer {
            label = "SYM";
            // Hold N or Tab to activate. Visual map: docs/KEYMAP.md#symbol-layer

            bindings = <
       &roundbkt  &squarebkt  &curlbkt       &kp GRAVE      &kp TILDE         &kp CARET  &kp F1  &kp F2   &kp F3   &kp F4
       &kp EXCL   &kp AT      &kp HASH       &kp DOLLAR     &kp PIPE          &trans     &kp F5  &kp F6   &kp F7   &kp F8
&none  &kp PRCNT  &kp CARET   &kp AMPERSAND  &kp BACKSLASH  &kp UNDERSCORE    &trans     &kp F9  &kp F10  &kp F11  &kp F12  &none
                              &none          &none          &none             &none      &none   &none
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        bluetooth_layer {
            label = "BLU";
            // Hold Space + Backspace to activate. Visual map: docs/KEYMAP.md#bluetooth-layer

            bindings = <
       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none        &none         &none         &bt BT_CLR    &none
       &none         &none         &none         &none         &none           &none        &kp C_VOL_DN  &kp C_VOL_UP  &kp C_BRI_DN  &kp C_BRI_UP
&none  &none         &none         &none         &none         &bootloader     &bootloader  &none         &none         &none         &none         &none
                                   &sys_reset    &trans        &trans          &trans       &trans        &sys_reset
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
    };
};
